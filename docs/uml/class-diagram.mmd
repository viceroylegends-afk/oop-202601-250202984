classDiagram
    direction TB

    namespace kontrak {
        class DapatDipinjam {
            <<interface>>
            +bisaDipinjam() boolean
        }
        class AturanDenda {
            <<interface>>
            +hitung(Aset aset, int hariTerlambat) long
        }
    }

    namespace model {
        class Aset {
            <<abstract>>
            -String kode
            -String nama
            -StatusAset status
            -Kondisi kondisi
            +getKode() String
            +getNama() String
            +getStatus() StatusAset
            +getKondisi() Kondisi
            +setNama(String nama) void
            +setStatus(StatusAset status) void
            +setKondisi(Kondisi kondisi) void
            +bisaDipinjam() boolean
            +getJenis() JenisAset
            +hitungDenda(int hariTerlambat) long*
            #dendaDasar(int hariTerlambat) long
        }
        class Ruang {
            -int kapasitas
            +getKapasitas() int
            +getJenis() JenisAset
            +hitungDenda(int hariTerlambat) long
        }
        class Laptop {
            -String spesifikasi
            -String nomorInventaris
            +getSpesifikasi() String
            +getNomorInventaris() String
            +getJenis() JenisAset
            +hitungDenda(int hariTerlambat) long
        }
        class AlatLab {
            -String laboratorium
            -TingkatRisiko tingkatRisiko
            +getLaboratorium() String
            +getTingkatRisiko() TingkatRisiko
            +getJenis() JenisAset
            +hitungDenda(int hariTerlambat) long
        }
        class Peminjam {
            <<record>>
            -String id
            -String nama
            +id() String
            +nama() String
        }
        class Peminjaman {
            -String id
            -LocalDateTime mulai
            -LocalDateTime selesai
            -StatusPeminjaman status
            +getId() String
            +getPeminjam() Peminjam
            +getAset() Aset
            +getMulai() LocalDateTime
            +getSelesai() LocalDateTime
            +getStatus() StatusPeminjaman
            +setStatusDariPenyimpanan(StatusPeminjaman status) void
            +ubahStatus(StatusPeminjaman baru) void
        }
        class StatusAset {
            <<enumeration>>
        }
        class Kondisi {
            <<enumeration>>
        }
        class JenisAset {
            <<enumeration>>
        }
        class TingkatRisiko {
            <<enumeration>>
        }
        class StatusPeminjaman {
            <<enumeration>>
        }
    }

    namespace denda {
        class DendaFlat {
            +hitung(Aset aset, int hariTerlambat) long
        }
        class DendaProgresif {
            -int BATAS_HARI$
            +hitung(Aset aset, int hariTerlambat) long
        }
    }

    namespace katalog {
        class KatalogAset {
            -List~Aset~ daftar
            +tambah(Aset aset) void
            +semua() List~Aset~
            +cari(String kata) List~Aset~
            +cari(String kata, JenisAset jenis) List~Aset~
        }
    }

    %% Generalization
    Aset <|-- Ruang
    Aset <|-- Laptop
    Aset <|-- AlatLab

    %% Realization
    DapatDipinjam <|.. Aset
    AturanDenda <|.. DendaFlat
    AturanDenda <|.. DendaProgresif

    %% Association (dengan multiplicity)
    Peminjaman "0..*" --> "1" Peminjam : peminjam
    Peminjaman "0..*" --> "1" Aset : aset

    %% Aggregation: Aset dibuat di luar katalog dan hanya dititipkan lewat tambah()
    KatalogAset o-- "0..*" Aset : daftar

    %% Dependency dan penggunaan tipe enum
    AturanDenda ..> Aset
    Aset --> StatusAset
    Aset --> Kondisi
    Aset ..> JenisAset
    AlatLab --> TingkatRisiko
    Peminjaman --> StatusPeminjaman